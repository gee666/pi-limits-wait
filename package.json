{
  "name": "oira666_pi-limits-wait",
  "version": "0.6.8",
  "description": "Extension for PI that allows to automatically wait for limits to reset and retry the request",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "license": "MIT",
  "files": [
    "src",
    "!src/__tests__",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gee666/pi-limits-wait.git"
  },
  "bugs": {
    "url": "https://github.com/gee666/pi-limits-wait/issues"
  },
  "homepage": "https://github.com/gee666/pi-limits-wait#readme",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run check",
    "test": "tsx src/__tests__/test-extension.ts && tsx src/__tests__/test-wait-ui.ts",
    "test:e2e": "node scripts/test-e2e.mjs",
    "test:integration": "tsx src/__tests__/test-integration.ts",
    "test:e2e:evergreen": "node scripts/test-evergreen-e2e.mjs",
    "test:evergreen": "npm test && npm run test:integration && npm run test:e2e:evergreen",
    "pack:check": "npm pack --dry-run",
    "prepublishOnly": "npm run check && npm test && npm run pack:check"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=1.4.0",
    "@earendil-works/pi-coding-agent": ">=1.4.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
